    },
    "%@ is not owned by your user account." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is not owned by your user account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の所有者があなたのユーザアカウントではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 소유자가 사용자 계정이 아닙니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không thuộc sở hữu của tài khoản người dùng của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
